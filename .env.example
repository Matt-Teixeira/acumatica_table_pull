# acumatica_sync .env template. .env itself is gitignored — this file is the
# tracked record of required keys. Only keys the code or the build actually
# reads appear here (dead keys removed 2026-08-25, owner-approved; see
# CLAUDE.md "Environment").

APP_NAME=acumatica_sync

## Local Docker PG (the app also accepts PG_HOST/PG_USER/... aliases — see
## db/pg_pool.js — but this is the active set on this host)
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
# 'require' = encrypted but NO cert verification (current fleet state).
# The verify-full flip belongs to the DB-roles rollout — see CLAUDE.md.
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# Acumatica OData (read-only GET; Basic auth). The URI contains $format/$expand
# sequences — compose prints interpolation warnings for them (accepted A21-07);
# dotenv delivers them intact because compose has no env_file.
PROD_OD_EQUIPMENT_URI=
PROD_LOGIN_NAME=
PROD_LOGIN_PW=

## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>

# USER_ID drives the image tag (acu-sync:${USER_ID}) and the build LABEL.
# Dev = your host username; the release copy gets svc via the #RELEASE: line,
# applied by build-release.sh to the DEPLOYED .env only.
USER_ID=         # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc

# CONTAINER RUN USER: do NOT set RUN_USER here. entrypoint.sh defaults to svc
# (one place decides the production identity); dev runs pass it on the command
# line:  RUN_USER=<you> docker compose run --rm app node index.js
# (IMAGE_TAG retired 2026-08-25 — the image tag is now acu-sync:${USER_ID}.)
