# Environment
ENV='prod'

# Logger
LOGGER='prod'

## PROD
# PG_PORT=
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=

## STAGING (Azure - commented out)
# PG_PORT=
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=

## Local Docker PG
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt


# Production API Login
PROD_LOGIN_URI=
PROD_LOGIN_NAME=
PROD_LOGIN_PW=
PROD_LOGIN_COMPANY=

# Production Equipment API
PROD_EQUIPMENT_URI=
PROD_OD_EQUIPMENT_URI=



# DEV API LOGIN
DEV_LOGIN_URI=
DEV_LOGIN_NAME=
DEV_LOGIN_PW=
DEV_LOGIN_COMPANY=

# DEV Equipment URI
DEV_EQUP_URI=
## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>
RUN_USER=svc
IMAGE_TAG=       # REQUIRED: image tag compose runs on this host, e.g. staging
